# ============================================================
# DroneLiveStreamDemo — launcher environment config
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.
# ============================================================

# ----------------------------------------------------------
# Network
# ----------------------------------------------------------

# LAN IP of this machine.
# The Vision Pro (or any remote client) uses this to reach
# the HLS video and RTSP audio streams.
# Run `ipconfig getifaddr en0` (Mac) or `ipconfig` (Windows) to find it.
STREAM_HOST=192.168.x.x

# ----------------------------------------------------------
# Mosquitto (MQTT broker)
# ----------------------------------------------------------

# Full path to the mosquitto binary.
# Mac (Homebrew Intel):  /usr/local/opt/mosquitto/sbin/mosquitto
# Mac (Homebrew Apple):  /opt/homebrew/opt/mosquitto/sbin/mosquitto
# Windows default:       C:\Program Files\mosquitto\mosquitto.exe
MOSQUITTO_BIN=/usr/local/opt/mosquitto/sbin/mosquitto

# Full path to the mosquitto config file.
# Mac (Homebrew Intel):  /usr/local/etc/mosquitto/mosquitto.conf
# Mac (Homebrew Apple):  /opt/homebrew/etc/mosquitto/mosquitto.conf
# Windows default:       C:\Program Files\mosquitto\mosquitto.conf
MOSQUITTO_CONF=/usr/local/etc/mosquitto/mosquitto.conf

# ----------------------------------------------------------
# MediaMTX (RTSP/HLS server)
# ----------------------------------------------------------
# mediamtx is always launched from bin/mediamtx(.exe) inside the repo.
# No configuration needed here.
