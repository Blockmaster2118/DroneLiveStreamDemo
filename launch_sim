#!/bin/bash
# launch_sim.sh — Mac launcher for DroneLiveStreamDemo

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Resolve REPO to the directory containing this script
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load .env from the repo root
ENV_FILE="$REPO/.env"
if [[ ! -f "$ENV_FILE" ]]; then
    echo -e "${RED}Error:${RESET} .env not found at $ENV_FILE"
    echo -e "Copy .env.example to .env and fill in your values."
    exit 1
fi
set -a
source "$ENV_FILE"
set +a

# Validate required vars
for var in STREAM_HOST MOSQUITTO_BIN MOSQUITTO_CONF; do
    if [[ -z "${!var}" ]]; then
        echo -e "${RED}Error:${RESET} $var is not set in .env"
        exit 1
    fi
done

MEDIAMTX_BIN="$REPO/bin/mediamtx"

export STREAM_HOST

cleanup() {
    echo -e "\n${BOLD}Shutting down...${RESET}"
    kill "$MOSQUITTO_PID" "$MEDIAMTX_PID" "$DOCK_PID" "$API_PID" 2>/dev/null
    wait "$MOSQUITTO_PID" "$MEDIAMTX_PID" "$DOCK_PID" "$API_PID" 2>/dev/null
    echo -e "${GREEN}All processes stopped.${RESET}"
    exit 0
}

trap cleanup SIGINT SIGTERM

# prefix each line with a coloured service tag; optional third arg suppresses noisy lines
prefix_output() {
    local color="$1"
    local label="$2"
    local suppress="${3:-}"
    while IFS= read -r line; do
        [[ -n "$suppress" && "$line" =~ $suppress ]] && continue
        echo -e "${color}[${label}]${RESET} ${line}"
    done
}

echo -e "\n${BOLD}${CYAN}=== Drone Sim Launcher (Mac) ===${RESET}\n"
echo -e "${DIM}REPO:        $REPO${RESET}"
echo -e "${DIM}STREAM_HOST: $STREAM_HOST${RESET}\n"

# mosquitto
MOSQUITTO_SUPPRESS="Bridge support|Persistence support|TLS support|TLS-PSK|Websockets support|Starting in local only|Create a configuration|For more details"
echo -e "${RED}[mosquitto]${RESET} Starting MQTT broker..."
"$MOSQUITTO_BIN" -c "$MOSQUITTO_CONF" 2>&1 \
    | prefix_output "$RED" "mosquitto" "$MOSQUITTO_SUPPRESS" &
MOSQUITTO_PID=$!
sleep 3

# mediamtx
MEDIAMTX_SUPPRESS="RTMP|HLS listener|WebRTC listener|SRT listener|RTSP listener"
echo -e "${YELLOW}[mediamtx]${RESET} Starting RTSP/HLS server..."
"$MEDIAMTX_BIN" "$REPO/bin/mediamtx.yml" 2>&1 \
    | prefix_output "$YELLOW" "mediamtx" "$MEDIAMTX_SUPPRESS" &
MEDIAMTX_PID=$!
sleep 1

# dock simulator
DOCK_SUPPRESS="built with Apple|configuration:|libavutil|libavcodec|libavformat|libavdevice|libavfilter|libswscale|libswresample|major_brand|minor_version|compatible_brands|encoder :|Duration:|Stream #|handler_name|Stream mapping|Press \[q\]|Output #|Metadata:"
echo -e "${GREEN}[dock_sim]${RESET} Starting dock simulator..."
cd "$REPO/dock" && python3 dock_sim.py 2>&1 \
    | prefix_output "$GREEN" "dock_sim" "$DOCK_SUPPRESS" &
DOCK_PID=$!
sleep 1

# API server
echo -e "${BLUE}[api_sim]${RESET} Starting API server..."
cd "$REPO/api" && node api_sim.js 2>&1 \
    | prefix_output "$BLUE" "api_sim" &
API_PID=$!
sleep 1

echo -e "\n${BOLD}All services running.${RESET} ${DIM}Ctrl+C to stop.${RESET}\n"

wait